# Populate only the environments enabled for this installation. Do not commit .env.
UAT_DB_USER=
UAT_DB_PASSWORD=
UAT_DB_HOST=
UAT_DB_PORT=1521
UAT_DB_SERVICE=

PREPROD_DB_USER=
PREPROD_DB_PASSWORD=
PREPROD_DB_HOST=
PREPROD_DB_PORT=1521
PREPROD_DB_SERVICE=

# Comma-separated list. Each name needs matching <NAME>_DB_* variables above.
ESB_ENVIRONMENTS=UAT,PREPROD
FLASK_SECRET_KEY=change-this-to-a-long-random-value
LOG_LEVEL=INFO
